[
	{
		"label": "Run Tests",
		"command": "cmake --build --preset=release --target EyeAICoreTests && ctest --preset=default",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"reveal_target": "dock",
		"hide": "never"
	},
	{
		"label": "Prepare DIODE dataset",
		"command": "$ZED_WORKTREE_ROOT/metric_depth/scripts/build_and_run_prepare_dataset.sh",
		"args": [
			"diode",
			"~/Downloads/DIODE/diode_testing_dataset/",
			"~/Downloads/DIODE/prepared_diode_testing_dataset/"
		],
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"reveal_target": "dock",
		"hide": "never"
	},
	{
		"label": "Prepare SUNRGBD dataset",
		"command": "$ZED_WORKTREE_ROOT/metric_depth/scripts/build_and_run_prepare_dataset.sh",
		"args": [
			"sun_rgbd",
			"~/Downloads/SUNRGBD/",
			"~/Downloads/prepared_SUNRGBD/"
		],
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"reveal_target": "dock",
		"hide": "never"
	}
]
