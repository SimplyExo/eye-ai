{
	"version": 3,
	"configurePresets": [
		{
			"name": "default",
			"hidden": true,
			"description": "Default development setup",
			"binaryDir": "${sourceDir}/build",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_COLOR_DIAGNOSTICS": true,
				"EYE_AI_CORE_GENERATE_DOCS": true,
				"EYE_AI_CORE_ENABLE_TESTS": true
			}
		},
		{
			"name": "debug",
			"displayName": "Debug",
			"inherits": "default",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "release",
			"displayName": "Release",
			"inherits": "default",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "profiling",
			"displayName": "Profiling",
			"inherits": "release",
			"cacheVariables": {
				"EYE_AI_CORE_ENABLE_TRACY_PROFILER": true
			}
		},
		{
			"name": "tests",
			"displayName": "Tests (INTERNAL USE ONLY)",
			"inherits": "debug",
			"binaryDir": "${sourceDir}/build/tests"
		}
	],
	"buildPresets": [
		{
			"name": "debug",
			"displayName": "Debug",
			"configurePreset": "debug",
			"jobs": 8
		},
		{
			"name": "release",
			"displayName": "Release",
			"configurePreset": "release",
			"jobs": 8
		},
		{
			"name": "profiling",
			"displayName": "Profiling",
			"configurePreset": "profiling",
			"jobs": 8
		},
		{
			"name": "generate_docs",
			"displayName": "Generate EyeAICore Docs",
			"configurePreset": "debug",
			"jobs": 8,
			"targets": "EyeAICoreDoxygenDocs"
		}
	],
	"testPresets": [
		{
			"name": "default",
			"displayName": "Default",
			"configurePreset": "tests",
			"output": {
				"outputOnFailure": true,
				"shortProgress": true
			},
			"execution": {
				"stopOnFailure": true
			}
		}
	]
}
