[
	{
		"label": "Generate EyeAICoreDocs",
		"command": "cmake --build --preset=generate_docs",
		"cwd": "$ZED_WORKTREE_ROOT/EyeAICore",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "never",
		"hide": "on_success"
	},
	{
		"label": "EyeAICoreDocs Live Preview (http://localhost:8000)",
		"command": "command -v livereload >/dev/null && livereload . -p 8000 -w 1 || python3 -m http.server 8000",
		"cwd": "$ZED_WORKTREE_ROOT/EyeAICore/build/docs/html",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "never",
		"hide": "on_success"
	}
]
