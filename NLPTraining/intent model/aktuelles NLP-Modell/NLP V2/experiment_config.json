      "training_dataset": "mixed_train",
      "training_function": "train_m1",
      "initialization": "initial_weights"
    },
    {
      "id": "M2",
      "description": "Clean pretraining -> joint Clean + Vosk fine-tuning",
      "learning_rate": 0.0001,
      "training_dataset": "mixed_train",
      "training_function": "train_m2",
      "initialization": "m0_checkpoint"
    },
    {
      "id": "M3",
      "description": "Clean pretraining -> Vosk-only fine-tuning",
      "learning_rate": 0.0001,
      "training_dataset": "vosk_train",
      "training_function": "train_m3",
