#! /bin/sh
### BEGIN INIT INFO
# Provides:          hotspot
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     S 2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Wi-Fi Hotspot AP Service
### END INIT INFO

case "$1" in
    start)
        echo "Starting Wi-Fi Hotspot..."
        
        # load wifi driver
        modprobe brcmfmac
        sleep 1

        ip link set wlan0 down
        ip addr flush dev wlan0
        ip addr add 192.168.4.1/24 dev wlan0
        ip link set wlan0 up
        
        iw dev wlan0 set power_save off

        hostapd -B /etc/hostapd-eyeai.conf
        dnsmasq -C /etc/dnsmasq-eyeai.conf
        ;;
    stop)
        echo "Stopping Wi-Fi Hotspot..."
        killall dnsmasq
        killall hostapd
        ip link set wlan0 down
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
