<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
	<base-config cleartextTrafficPermitted="true">
		<trust-anchors>
			<certificates src="system" />
		</trust-anchors>
	</base-config>

	<domain-config>
		<domain includeSubdomains="false">
			192.168.4.1
		</domain>

		<trust-anchors>
			<certificates src="@raw/vision" />
			<certificates src="system" />
		</trust-anchors>
	</domain-config>
</network-security-config>
