<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ungranted_permissions_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/ungranted_permissions_notice_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:text="@string/allow_camera_and_microphone_permission_notice"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/allow_camera_permission_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_weight="0"
            android:backgroundTint="@color/default_blue"
            android:text="@string/allow"
            android:textColor="@color/white"
            android:textSize="18sp" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.5">

        <androidx.camera.view.PreviewView
            android:id="@+id/camera_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="performance"
            app:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/media_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/media_view_description"
            app:implementationMode="performance"
            app:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/debug_input_bitmap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/debug_input_bitmap_image_description"
            android:scaleType="fitCenter" />

        <com.algorithmic_alliance.eyeaiapp.UI.OverlayViewOD
            android:id="@+id/overlay_object_detection"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.algorithmic_alliance.eyeaiapp.UI.OverlayViewOCR
            android:id="@+id/overlay_ocr"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:textAlignment="center">

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/speech_recognition_partial_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="40dp"
                android:background="@color/black"
                android:contentDescription="@string/speech_recognition_partial_result_description"
                android:text=""
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/speech_recognition_final_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="40dp"
                android:layout_marginBottom="20dp"
                android:background="@color/black"
                android:contentDescription="@string/speech_recognition_final_result_description"
                android:text=""
                android:textAlignment="center"
                android:textColor="@color/final_speech_recognition"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/llm_response"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="40dp"
                android:background="@color/black"
                android:contentDescription="@string/llm_response_description"
                android:text=""
                android:textAlignment="center"
                android:textColor="@color/llm_response"
                android:textSize="25sp" />

        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.5">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black">

            <ImageView
                android:id="@+id/depth_preview_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/depth_preview_image_description"
                android:scaleType="fitCenter" />

        </FrameLayout>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <TextView
                android:id="@+id/performance_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/white"
                android:textSize="11sp" />

        </ScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/stop_tts_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="120dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="@color/red"
            android:contentDescription="@string/stop_tts_description"
            android:src="@drawable/stop_square"
            android:tint="@android:color/white"
            app:borderWidth="0dp"
            app:rippleColor="@color/ripple_red" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_gravity="bottom|end"
            android:layout_margin="30dp"
            android:backgroundTint="@color/white"
            android:contentDescription="@string/settings_button_description"
            android:foregroundTint="@color/white"
            android:src="@android:drawable/ic_menu_preferences"
            app:borderWidth="0dp"
            app:rippleColor="@android:color/transparent" />

    </RelativeLayout>

</LinearLayout>